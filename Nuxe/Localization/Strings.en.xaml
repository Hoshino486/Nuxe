<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Main window -->
    <sys:String x:Key="Window_Title">Nuxe {0}</sys:String>
    <sys:String x:Key="Tab_Basic">Basic</sys:String>
    <sys:String x:Key="Tab_Advanced">Advanced</sys:String>
    <sys:String x:Key="Tab_Unpack">Unpack</sys:String>
    <sys:String x:Key="Tab_Patch">Patch</sys:String>
    <sys:String x:Key="Tab_Restore">Restore</sys:String>
    <sys:String x:Key="Tab_Decrypt">Decrypt</sys:String>

    <sys:String x:Key="Label_GameExecutable">Game Executable</sys:String>
    <sys:String x:Key="Label_GameDirectory">Game Directory</sys:String>
    <sys:String x:Key="Label_GameType">Game Type</sys:String>
    <sys:String x:Key="Label_Language">Language</sys:String>

    <sys:String x:Key="Prompt_SelectGameExe">Select game executable</sys:String>
    <sys:String x:Key="Prompt_SelectGameDir">Select game directory</sys:String>
    <sys:String x:Key="Prompt_SelectExeFile">Select executable file</sys:String>
    <sys:String x:Key="Prompt_SelectUnpackDir">Select unpack directory</sys:String>
    <sys:String x:Key="Prompt_PatchOutputSaveAs">Save patched file as...</sys:String>
    <sys:String x:Key="Filter_Executable">Executable file|*.exe;eboot.bin;default.xex;main</sys:String>

    <sys:String x:Key="Button_Unpack">Unpack</sys:String>
    <sys:String x:Key="Button_Patch">Patch</sys:String>
    <sys:String x:Key="Button_Restore">Restore</sys:String>
    <sys:String x:Key="Button_Decrypt">Decrypt</sys:String>
    <sys:String x:Key="Button_Abort">Abort</sys:String>
    <sys:String x:Key="Button_Browse">Browse</sys:String>
    <sys:String x:Key="Button_Explore">Explore</sys:String>
    <sys:String x:Key="Button_OK">OK</sys:String>

    <sys:String x:Key="Check_UseUnpackDir">Unpack to separate directory (disables backup)</sys:String>
    <sys:String x:Key="Check_UseUnpackFilter">Filter files (Regex)</sys:String>
    <sys:String x:Key="Check_UnpackOverwrite">Overwrite existing files</sys:String>
    <sys:String x:Key="Check_PatchOutputPath">Save to separate file (disables backup)</sys:String>

    <sys:String x:Key="Group_Status">Status</sys:String>

    <!-- Operation steps -->
    <sys:String x:Key="Step_Unpack1">(Step 1/4) Loading headers</sys:String>
    <sys:String x:Key="Step_Unpack2">(Step 2/4) Backing up files</sys:String>
    <sys:String x:Key="Step_Unpack3">(Step 3/4) Auditing files</sys:String>
    <sys:String x:Key="Step_Unpack4">(Step 4/4) Unpacking files</sys:String>
    <sys:String x:Key="Step_Patch1">(Step 1/1) Patching aliases</sys:String>
    <sys:String x:Key="Step_Restore1">(Step 1/2) Deleting unpacked files</sys:String>
    <sys:String x:Key="Step_Restore2">(Step 2/2) Restoring backup files</sys:String>
    <sys:String x:Key="Step_Decrypt1">(Step 1/1) Decrypting headers</sys:String>

    <!-- Progress formats -->
    <sys:String x:Key="Progress_File">{0} - (File {1}/{2}) {3}</sys:String>
    <sys:String x:Key="Progress_Directory">{0} - (Directory {1}/{2}) {3}</sys:String>
    <sys:String x:Key="Progress_Alias">{0} - (Alias {1}/{2}) {3}</sys:String>
    <sys:String x:Key="Progress_Path">{0} - (Path {1}/{2}) {3}</sys:String>
    <sys:String x:Key="Progress_Header">{0} - (Header {1}/{2}) {3}</sys:String>

    <!-- Operation verbs and results -->
    <sys:String x:Key="Verb_Unpack">Unpacking</sys:String>
    <sys:String x:Key="Verb_Patch">Patching</sys:String>
    <sys:String x:Key="Verb_Restore">Restoration</sys:String>
    <sys:String x:Key="Verb_Decrypt">Decrypt</sys:String>
    <sys:String x:Key="Status_Completed">{0} completed in {1}!</sys:String>
    <sys:String x:Key="Status_Aborted">{0} aborted.</sys:String>
    <sys:String x:Key="Status_Failed">{0} failed.</sys:String>
    <sys:String x:Key="Time_Hour">h</sys:String>
    <sys:String x:Key="Time_Minute">m</sys:String>
    <sys:String x:Key="Time_Second">s</sys:String>

    <!-- Error messages -->
    <sys:String x:Key="Err_Unexpected">An unexpected error occurred.</sys:String>
    <sys:String x:Key="Err_PathSuffix">
Path: "{0}"</sys:String>
    <sys:String x:Key="Err_GameDirNotFound">Game directory not found; please select a valid directory.</sys:String>
    <sys:String x:Key="Err_HeaderFileNotFound">Header file not found; please verify integrity for Steam games.</sys:String>
    <sys:String x:Key="Err_DataFileNotFound">Data file not found; please verify integrity for Steam games.</sys:String>
    <sys:String x:Key="Err_NotEnoughSpace">Not enough disk space to unpack files; {0:F2} GB required, {1:F2} GB available.</sys:String>
    <sys:String x:Key="Err_PatchUnsupported">Executable patching is not supported for this game.</sys:String>
    <sys:String x:Key="Err_ExeNotFound">Executable file not found; please select a valid file.</sys:String>
    <sys:String x:Key="Err_NoAliases">No aliases found to patch; the file may already be patched, or you may have selected the wrong file.</sys:String>
    <sys:String x:Key="Err_ManualGameRequired">Game type must be selected manually in advanced mode.</sys:String>
    <sys:String x:Key="Err_GameConfigsDirNotFound">Game configs directory not found; please ensure that you've fully extracted the program files.</sys:String>
    <sys:String x:Key="Err_DetectGameFailed">Failed to detect game type; please ensure that you've selected a valid game directory.</sys:String>
    <sys:String x:Key="Err_BinderKeysDirNotFound">BinderKeys game directory not found; please ensure you've extracted the program fully.</sys:String>
    <sys:String x:Key="Err_EncryptionKeyNotFound">Encryption key not found; please ensure you've extracted the program fully.</sys:String>
    <sys:String x:Key="Err_EncryptionKeyNotFoundSteam">Encryption key not found; please verify integrity for Steam games.</sys:String>
    <sys:String x:Key="Err_HashDictNotFound">Hash dictionary not found; please ensure you've extracted the program fully.</sys:String>
    <sys:String x:Key="Err_InvalidPathInputMode">Invalid PathInput Mode={0}</sys:String>

    <!-- Language names -->
    <sys:String x:Key="Language_zh">简体中文</sys:String>
    <sys:String x:Key="Language_en">English</sys:String>

</ResourceDictionary>
