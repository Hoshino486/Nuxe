<Window x:Class="Nuxe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Nuxe.Controls"
        xmlns:viewmodels="clr-namespace:Nuxe.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="{Binding TitleText}" d:Title="Nuxe 0.0.0" 
        SizeToContent="Height" MinWidth="450" Width="800" 
        Loaded="Window_Loaded" Closed="Window_Closed">
    
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal"/>
    </Window.TaskbarItemInfo>
    
    <StackPanel Margin="6">
        <TabControl Name="TabControlSettings">
            <TabItem Header="{DynamicResource Tab_Basic}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Content="{DynamicResource Label_GameExecutable}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Label Content="{DynamicResource Label_Language}" VerticalAlignment="Center"/>
                            <ComboBox Name="ComboBoxLanguage" Width="130" Height="24" Margin="3"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="ComboBoxLanguage_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <controls:PathInput Mode="OpenFile" Prompt="{DynamicResource Prompt_SelectGameExe}" FileFilter="{DynamicResource Filter_Executable}" Path="{Binding GameExe, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="ButtonBasicUnpack_Click" Content="{DynamicResource Button_Unpack}"/>
                        <Button Click="ButtonBasicPatch_Click" Content="{DynamicResource Button_Patch}"/>
                        <Button Click="ButtonBasicRestore_Click" Content="{DynamicResource Button_Restore}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Tab_Advanced}">
                <TabControl Margin="-3 3 -3 -3">
                    <TabItem Header="{DynamicResource Tab_Unpack}">
                        <StackPanel>
                            <Label Content="{DynamicResource Label_GameDirectory}"/>
                            <controls:PathInput Mode="OpenFolder" Prompt="{DynamicResource Prompt_SelectGameDir}" Path="{Binding GameDir, Mode=TwoWay}"/>

                            <CheckBox IsChecked="{Binding UseUnpackDir}" Content="{DynamicResource Check_UseUnpackDir}"/>
                            <controls:PathInput IsEnabled="{Binding UseUnpackDir}" Mode="OpenFolder" Prompt="{DynamicResource Prompt_SelectUnpackDir}" Path="{Binding UnpackDir, Mode=TwoWay}"/>

                            <CheckBox IsChecked="{Binding UseUnpackFilter}" Content="{DynamicResource Check_UseUnpackFilter}"/>
                            <TextBox IsEnabled="{Binding UseUnpackFilter}" Text="{Binding UnpackFilter, Mode=TwoWay}"/>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding UnpackOverwrite}" Content="{DynamicResource Check_UnpackOverwrite}"/>
                            </StackPanel>

                            <StackPanel>
                                <Label Content="{DynamicResource Label_GameType}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding GameConfigItems}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ManualGame}"/>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ButtonAdvancedUnpack_Click" Content="{DynamicResource Button_Unpack}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_Patch}">
                        <StackPanel>
                            <Label Content="{DynamicResource Label_GameExecutable}"/>
                            <controls:PathInput Mode="OpenFile" Prompt="{DynamicResource Prompt_SelectExeFile}" Path="{Binding GameExe, Mode=TwoWay}"/>

                            <CheckBox IsChecked="{Binding UsePatchOutputPath}" Content="{DynamicResource Check_PatchOutputPath}"/>
                            <controls:PathInput Mode="SaveFile" Prompt="{DynamicResource Prompt_PatchOutputSaveAs}" Path="{Binding PatchOutputPath, Mode=TwoWay}"/>

                            <StackPanel>
                                <Label Content="{DynamicResource Label_GameType}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding GameConfigItems}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ManualGame}"/>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ButtonAdvancedPatch_Click" Content="{DynamicResource Button_Patch}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_Restore}">
                        <StackPanel>
                            <Label Content="{DynamicResource Label_GameDirectory}"/>
                            <controls:PathInput Mode="OpenFolder" Prompt="{DynamicResource Prompt_SelectGameDir}"  Path="{Binding GameDir, Mode=TwoWay}"/>

                            <StackPanel>
                                <Label Content="{DynamicResource Label_GameType}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding GameConfigItems}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ManualGame}"/>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ButtonAdvancedRestore_Click" Content="{DynamicResource Button_Restore}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource Tab_Decrypt}">
                        <StackPanel>
                            <Label Content="{DynamicResource Label_GameDirectory}"/>
                            <controls:PathInput Mode="OpenFolder" Prompt="{DynamicResource Prompt_SelectGameDir}"  Path="{Binding GameDir, Mode=TwoWay}"/>

                            <StackPanel>
                                <Label Content="{DynamicResource Label_GameType}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding GameConfigItems}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ManualGame}"/>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ButtonAdvancedDecrypt_Click" Content="{DynamicResource Button_Decrypt}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <GroupBox Header="{DynamicResource Group_Status}">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="TextBoxStatus" Grid.Column="0" IsReadOnly="True"/>
                    <Button Name="ButtonAbort" Grid.Column="1" IsEnabled="False" Click="ButtonAbort_Click" Content="{DynamicResource Button_Abort}"/>
                </Grid>
                <ProgressBar Name="ProgressBar" d:Value="50"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
    
</Window>
